# Copy to .env and fill ONE provider's key. Never commit .env.
AI_PROVIDER=openai
# Explicit permission to send anonymous recommendation features to the cloud.
CQ_ALLOW_CLOUD_DATA=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Alternative: set AI_PROVIDER=nvidia and fill this key.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Alternative: AI_PROVIDER=ollama (no cloud or API key).
OLLAMA_MODEL=qwen3:1.7b

# Local hackathon demo only. Replace for non-demo use.
CQ_EMPLOYEE_PASSWORD=quest-demo
CQ_HR_PASSWORD=hr-quest-demo
